{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ragnroll.local/schemas/campaign-nlp-v1.json",
  "title": "RAGnROLL Campaign NLP Output",
  "type": "object",
  "required": ["schema_version", "record", "classification", "entities", "structured", "quality", "provenance"],
  "properties": {
    "schema_version": {"const": "campaign-nlp-v1"},
    "record": {
      "type": "object",
      "required": ["id", "title", "source_url", "text_sha256"],
      "properties": {
        "id": {"type": ["string", "null"]},
        "title": {"type": ["string", "null"]},
        "source_url": {"type": ["string", "null"]},
        "text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "classification": {"type": "object", "required": ["product_category", "dimensions"]},
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["start", "end", "text", "label", "confidence", "source", "normalized", "evidence"],
        "properties": {
          "start": {"type": "integer", "minimum": 0},
          "end": {"type": "integer", "minimum": 1},
          "text": {"type": "string"},
          "label": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "source": {"enum": ["spacy_ner", "deterministic_rule"]},
          "normalized": {"type": ["object", "null"]},
          "evidence": {"type": "string"}
        }
      }
    },
    "structured": {"type": "object"},
    "quality": {"type": "object", "required": ["overall_confidence", "warnings", "entity_count"]},
    "provenance": {"type": "object"}
  }
}
