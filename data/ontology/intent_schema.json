      "başvuru şartları",
      "hangi belgeler",
      "kimler başvurabilir",
      "gereken evrak"
    ],
    "target_entities": [
      "DOCUMENT",
      "TARGET_CUSTOMER",
      "CONDITION",
      "APPLICATION_CHANNEL"
    ]
  },
  "rate_query": {
    "description": "Kâr payı, indirim veya paylaşım oranını sorar.",
    "patterns": [
      "oran kaç",
      "kâr payı",
      "indirim oranı",
      "paylaşım oranı"
    ],
    "target_entities": [
      "PROFIT_RATE",
      "DISCOUNT_RATE",
      "PROFIT_SHARING_RATIO"
    ]
  },
  "maturity_query": {
    "description": "Vade, ödeme süresi veya erteleme dönemini sorar.",
    "patterns": [
      "kaç ay",
