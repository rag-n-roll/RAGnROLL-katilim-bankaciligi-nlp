RAGNROLL_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RAGNROLL_DB_PATH=data/ragnroll.sqlite3
RAGNROLL_RUNTIME_ROOT=.
RAGNROLL_CHROMA_ENABLED=true
RAGNROLL_CHROMA_AUTO_INDEX=true
RAGNROLL_NLP_AUTO_ENRICH=false
RAGNROLL_NLP_MAX_RECORDS=0
RAGNROLL_NLP_MANIFEST=models/final_training/runtime_manifest.json
RAGNROLL_CHROMA_PATH=chroma_db
RAGNROLL_CHROMA_COLLECTION=katilim_bankaciligi_qwen3
RAGNROLL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
RAGNROLL_EMBEDDING_BATCH_SIZE=4
RAGNROLL_EMBEDDING_WARMUP=true
RAGNROLL_INDEX_BATCH_SIZE=64
RAGNROLL_LLM_ENABLED=true
RAGNROLL_LLM_BASE_URL=http://127.0.0.1:8001/v1
RAGNROLL_LLM_MODEL=gemma4:e4b-mlx
RAGNROLL_LLM_API_KEY=EMPTY
RAGNROLL_LLM_CONNECT_TIMEOUT=1
RAGNROLL_LLM_READ_TIMEOUT=120
RAGNROLL_LLM_MAX_TOKENS=900
RAGNROLL_LLM_TEMPERATURE=0.05
