RAGNROLL_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RAGNROLL_DB_PATH=data/ragnroll.sqlite3
RAGNROLL_RUNTIME_ROOT=.
RAGNROLL_CHROMA_ENABLED=true
RAGNROLL_CHROMA_AUTO_INDEX=true
RAGNROLL_NLP_AUTO_ENRICH=false
RAGNROLL_NLP_MAX_RECORDS=0
RAGNROLL_NLP_MANIFEST=models/final_training/runtime_manifest.json
RAGNROLL_CHROMA_PATH=chroma_db
RAGNROLL_CHROMA_COLLECTION=katilim_bankaciligi_qwen3
RAGNROLL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
RAGNROLL_EMBEDDING_BATCH_SIZE=4
RAGNROLL_EMBEDDING_WARMUP=true
RAGNROLL_INDEX_BATCH_SIZE=64
RAGNROLL_GENERATION_PROVIDER_ORDER=evren,local,deterministic
RAGNROLL_RETRIEVAL_PROVIDER_ORDER=evren_qdrant,local_qwen_chroma,bm25_graph
RAGNROLL_EVREN_ENABLED=true
RAGNROLL_EVREN_RETRIEVAL_ENABLED=true
RAGNROLL_EVREN_CIRCUIT_FAILURE_THRESHOLD=3
RAGNROLL_EVREN_CIRCUIT_OPEN_SECONDS=30
RAGNROLL_EVREN_MAX_PRETOKEN_RETRIES=1
RAGNROLL_SSE_HEARTBEAT_SECONDS=15
EVREN_LLM_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
EVREN_LLM_MODEL=llm-fast
EVREN_NLP_MODEL=llm-large
EVREN_NLP_MAX_TOKENS=1536
EVREN_ROUTER_MODEL=router
EVREN_GUARD_MODEL=guard
EVREN_EMBEDDING_MODEL=bge-m3-embed
EVREN_EMBEDDING_DIMENSIONS=1024
EVREN_CONNECT_TIMEOUT=5
EVREN_READ_TIMEOUT=1800
EVREN_MODELS_CACHE_TTL=300
EVREN_QDRANT_URL=https://evren-vektor.ssyz.org.tr
EVREN_QDRANT_PORT=443
EVREN_QDRANT_PREFIX=teamNN
EVREN_QDRANT_COLLECTION=katilim_campaigns_bge_m3_202608
EVREN_QDRANT_TIMEOUT=600
# Bu iki değer secret store veya yerel, git dışı .env üzerinden sağlanmalıdır.
EVREN_API_KEY=
EVREN_QDRANT_API_KEY=
RAGNROLL_LLM_ENABLED=true
RAGNROLL_LLM_BASE_URL=http://127.0.0.1:8001/v1
RAGNROLL_LLM_MODEL=gemma4:e4b-mlx
RAGNROLL_LLM_API_KEY=EMPTY
RAGNROLL_LLM_CONNECT_TIMEOUT=1
RAGNROLL_LLM_READ_TIMEOUT=120
RAGNROLL_LLM_MAX_TOKENS=900
RAGNROLL_LLM_TEMPERATURE=0.05
RAGNROLL_PROMPT_MODE=default
RAGNROLL_INTENT_PROMPT_PATH=configs/prompts/intent_prompt.json
# Ham kullanıcı girdisi içerir; yalnız açık onaylı geliştirme ortamında etkinleştirin.
# RAGNROLL_INTENT_TRACE_PATH=runtime/intent-planning/pending.jsonl
RAGNROLL_PROMPT_ARTIFACT=runtime/prompt-optimization/selected_prompt.json
RAGNROLL_PROMPT_DATASET_MANIFEST=data/model_training_data/dspy_prompt_examples.manifest.json
