{
  "definition": {
    "description": "Bir kavramın anlamını veya çalışma şeklini sorar.",
    "patterns": [
      "nedir",
      "ne demek",
      "nasıl çalışır",
      "açıklar mısın"
    ],
    "target_entities": [
      "ISLAMIC_CONTRACT",
      "PRODUCT",
      "ACCOUNT_TYPE",
      "PAYMENT_SYSTEM"
    ]
  },
  "product_search": {
    "description": "Belirli ihtiyaç için uygun ürün arar.",
    "patterns": [
      "hangi finansman",
      "hangi ürün",
      "uygun ürün",
      "ne kullanabilirim"
    ],
    "target_entities": [
      "PRODUCT",
      "PRODUCT_FAMILY",
      "GREEN_FINANCING_PRODUCT"
    ]
  },
  "product_comparison": {
    "description": "Ürünleri veya bankaları oran, vade, masraf ve avantaj açısından karşılaştırır.",
    "patterns": [
      "karşılaştır",
      "hangisi daha iyi",
      "en düşük",
      "en uzun vade"
    ],
    "target_entities": [
      "PRODUCT",
      "BANK",
      "PROFIT_RATE",
      "MATURITY",
      "FEE"
    ]
  },
  "application_requirements": {
    "description": "Başvuru koşullarını ve gerekli belgeleri sorar.",
